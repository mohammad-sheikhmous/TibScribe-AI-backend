# Copy to .env, then run: python scripts/generate_secrets.py
LARAVEL_APP_KEY=CHANGE_ME
MYSQL_DATABASE=tibscribe_ai
MYSQL_USER=tibscribe
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
AI_SERVICE_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OTP delivery. `log` is safe for local development (read the queue-worker logs).
# For real email delivery set MAIL_MAILER=smtp and configure the SMTP values below.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tibscribe.local
MAIL_FROM_NAME=TibScribe-AI
