# Copy to .env.modal; never commit the real file.
#
# This file is only an example/template.
# The real .env.modal contains production secrets and must stay outside Git.

# =============================================================================
# Laravel -> FastAPI service authentication
# =============================================================================

# Use the same SERVICE_TOKEN in Laravel/Render.
# Minimum 32 random characters.
SERVICE_TOKEN=replace-with-a-long-random-shared-secret


# =============================================================================
# AI database on Neon
# =============================================================================

# Pooled URL is preferred for runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/tibscribe_ai?sslmode=require&channel_binding=require

# Optional direct Neon URL for Alembic migrations.
# Leave empty to reuse DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/tibscribe_ai?sslmode=require&channel_binding=require


# =============================================================================
# Medical Canonicalization — PRE-AraBERT
# =============================================================================
#
# Pipeline:
#
# Whisper
#   -> Segmentation
#   -> Medical Canonicalization
#   -> AraBERT
#
# The canonicalization stage:
# - corrects obvious ASR errors
# - converts dialectal Arabic to clearer medical Arabic
# - corrects spelling/medical terminology
# - preserves the original text in text_raw
#
# Keep disabled until the LLM model/API key are configured and the stage
# is connected in app/main.py + app/core/pipeline.py.

CANONICALIZATION_ENABLED=false

# Current implementation:
# app/core/nlp/canonicalization_client.py
CANONICALIZATION_PROVIDER=openai_compatible

# LLM model used specifically for canonicalization.
# We will choose/configure the concrete model before enabling the stage.
CANONICALIZATION_MODEL=

# REAL SECRET:
# Put the real API key only in your private .env.modal,
# never in this example file and never in Git.
CANONICALIZATION_API_KEY=

# Leave empty for the provider's normal endpoint.
# Can later be used for another OpenAI-compatible backend.
CANONICALIZATION_BASE_URL=

# Maximum duration of one LLM request.
# On timeout/error the pipeline falls back to the original ASR text.
CANONICALIZATION_TIMEOUT_SEC=20

# Number of transcript segments sent per LLM request.
CANONICALIZATION_BATCH_SIZE=12

# Do not rewrite Whisper segments already flagged as suspicious.
CANONICALIZATION_SKIP_ASR_SUSPECT=true
