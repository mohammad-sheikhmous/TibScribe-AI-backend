# Copy to .env.modal; never commit the real file.
# Use the same SERVICE_TOKEN in Laravel/Render. Minimum 32 random characters.
SERVICE_TOKEN=replace-with-a-long-random-shared-secret

# AI database on Neon. Pooled URL is preferred for runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/tibscribe_ai?sslmode=require&channel_binding=require

# Optional direct Neon URL for Alembic migrations; leave empty to reuse DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/tibscribe_ai?sslmode=require&channel_binding=require

# --- P11 shadow clinical-language corrector ---
# The candidate is stored only for benchmarking/display experiments. In shadow mode it
# NEVER changes AraBERT, entities, SOAP routing, or KBS decisions. Raw Whisper text
# remains the clinical decision source. Safety guards reject changed numbers/negation/
# scope/speech-act. Use active only in controlled offline comparison tests.
CANONICALIZER_ENABLED=false
CANONICALIZER_REQUIRED=false
CANONICALIZER_MODE=shadow
CANONICALIZER_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
CANONICALIZER_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
CANONICALIZER_LOCAL_FILES_ONLY=false
