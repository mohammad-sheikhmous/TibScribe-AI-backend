# Copy to .env and adjust as needed. All values have sane defaults in app/config.py.

# --- Models ---
AROBERT_MODEL_NAME=aubmindlab/bert-base-arabertv02
MODEL_DIR=model_output
WHISPER_MODEL_SIZE=medium
ASR_LANGUAGE=ar


# --- P10 Clinical Arabic canonicalization ---
# Model-backed dialect -> MSA cleanup. Raw Whisper text is always retained and unsafe
# rewrites (numbers/negation/hypotheticals) are rejected automatically.
CANONICALIZER_ENABLED=false
CANONICALIZER_REQUIRED=false
CANONICALIZER_MODEL_NAME=Murhaf/AraT5-MSAizer
CANONICALIZER_MODEL_REVISION=d41102f584d7f2870e40ba9291b8d01b7dd57547
CANONICALIZER_LOCAL_FILES_ONLY=false

# --- Classifier ---
# Fallback only; model_output/model_config.json wins when present.
DEFAULT_MAX_LEN=128
LOW_CONFIDENCE_THRESHOLD=0.5
# true = refuse to start on preprocessing skew / missing weights (recommended in prod)
STRICT_MODEL_CHECKS=true

# --- Segmentation ---
# Keep at/below the training length distribution (data max ~135 chars).
SEGMENT_MAX_CHARS=140
WORD_PAUSE_GAP_SEC=0.5

# --- Storage ---
UPLOAD_DIR=data/uploads
RESULT_DIR=data/results
# Permanent, content-addressed audio archive. NEVER pruned by the application.
AUDIO_DIR=data/audio
# Log a warning (never delete) once the archive passes this size.
AUDIO_WARN_GB=50

# --- Database ---
# Empty = SQLite at data/scribe.db. Any SQLAlchemy URL works, e.g.
# postgresql+psycopg://user:pass@host/scribe
DATABASE_URL=
# Optional direct/admin URL for Alembic (e.g. Neon non-pooler endpoint).
MIGRATION_DATABASE_URL=
DB_ECHO=false

# --- Jobs / concurrency ---
EXECUTOR_MAX_WORKERS=1
MAX_CONCURRENT_JOBS=4
MAX_UPLOAD_MB=100

KBS_HISTORY_REPORTS=5

# Laravel -> FastAPI private service authentication
SERVICE_AUTH_REQUIRED=true
SERVICE_TOKEN=replace-with-at-least-32-random-characters
SERVICE_NAME=laravel
GATEWAY_IDENTITY_REQUIRED=true
