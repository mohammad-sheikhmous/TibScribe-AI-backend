# Copy to .env and adjust as needed.
# All values have sane defaults in app/config.py.

# =============================================================================
# Models
# =============================================================================

AROBERT_MODEL_NAME=aubmindlab/bert-base-arabertv02
MODEL_DIR=model_output
WHISPER_MODEL_SIZE=medium
ASR_LANGUAGE=ar


# =============================================================================
# Classifier
# =============================================================================

# Fallback only; model_output/model_config.json wins when present.
DEFAULT_MAX_LEN=128
LOW_CONFIDENCE_THRESHOLD=0.5

# true = refuse to start on preprocessing skew / missing weights
# Recommended in production.
STRICT_MODEL_CHECKS=true


# =============================================================================
# Segmentation
# =============================================================================

# Keep at/below the training length distribution.
SEGMENT_MAX_CHARS=140
WORD_PAUSE_GAP_SEC=0.5


# =============================================================================
# Medical Canonicalization — PRE-AraBERT
# =============================================================================
#
# Pipeline position:
#
# Whisper
#   -> Segmentation
#   -> Medical Canonicalization
#   -> AraBERT
#
# Purpose:
# - correct obvious ASR mistakes
# - dialect -> formal/medical Arabic
# - spelling correction
# - medical terminology normalization
#
# Original Whisper text remains preserved in text_raw.
#
# Keep disabled until API credentials/model are configured.

CANONICALIZATION_ENABLED=false

# LLM provider/backend.
CANONICALIZATION_PROVIDER=openai_compatible

# Model used for medical canonicalization.
# Configure the actual model in your private .env / deployment secret.
CANONICALIZATION_MODEL=

# NEVER put the real production API key in this example file.
CANONICALIZATION_API_KEY=

# Optional custom OpenAI-compatible base URL.
# Leave empty when the client should use its normal provider endpoint.
CANONICALIZATION_BASE_URL=

# Maximum duration for one LLM request.
# On timeout/error, the pipeline falls back to the original ASR text.
CANONICALIZATION_TIMEOUT_SEC=20

# Number of transcript segments sent in one LLM request.
CANONICALIZATION_BATCH_SIZE=12

# Do not send Whisper segments already marked as suspicious to the LLM.
CANONICALIZATION_SKIP_ASR_SUSPECT=true


# =============================================================================
# Storage
# =============================================================================

UPLOAD_DIR=data/uploads
RESULT_DIR=data/results

# Permanent, content-addressed audio archive.
# NEVER pruned by the application.
AUDIO_DIR=data/audio

# Log a warning (never delete) once the archive passes this size.
AUDIO_WARN_GB=50


# =============================================================================
# Database
# =============================================================================

# Empty = SQLite at data/scribe.db.
# Any SQLAlchemy URL works, e.g.
# postgresql+psycopg://user:pass@host/scribe
DATABASE_URL=

# Optional direct/admin URL for Alembic
# (e.g. Neon non-pooler endpoint).
MIGRATION_DATABASE_URL=

DB_ECHO=false


# =============================================================================
# Jobs / concurrency
# =============================================================================

EXECUTOR_MAX_WORKERS=1
MAX_CONCURRENT_JOBS=4
MAX_UPLOAD_MB=100


# =============================================================================
# KBS
# =============================================================================

KBS_HISTORY_REPORTS=5


# =============================================================================
# Laravel -> FastAPI private service authentication
# =============================================================================

SERVICE_AUTH_REQUIRED=true
SERVICE_TOKEN=replace-with-at-least-32-random-characters
SERVICE_NAME=laravel
GATEWAY_IDENTITY_REQUIRED=true