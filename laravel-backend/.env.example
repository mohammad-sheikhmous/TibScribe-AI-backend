APP_NAME=TibScribe-AI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
CORS_ALLOWED_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tibscribe_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tibscribe.local"
MAIL_FROM_NAME="${APP_NAME}"

# Private Laravel -> FastAPI connection. Never expose this token to React.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=replace-with-the-same-random-value-used-by-fastapi
AI_SERVICE_TIMEOUT=120
AI_SERVICE_CONNECT_TIMEOUT=5
AI_SERVICE_VERIFY_TLS=true
