APP_NAME=TibScribe-AI
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
CORS_ALLOWED_ORIGINS=https://YOUR-REACT-DOMAIN.example
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/tibscribe_laravel?sslmode=require&channel_binding=require
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
# Free Render has no free background worker; sync keeps OTP/notifications functional in one web service.
QUEUE_CONNECTION=sync

AI_SERVICE_URL=https://YOUR-MODAL-ENDPOINT.modal.run
AI_SERVICE_TOKEN=THE-SAME-LONG-SECRET-AS-MODAL
AI_SERVICE_TIMEOUT=300
AI_SERVICE_CONNECT_TIMEOUT=30
AI_SERVICE_VERIFY_TLS=true

# For real OTP emails, configure your SMTP provider. `log` is fine only for backend testing.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=TibScribe-AI
